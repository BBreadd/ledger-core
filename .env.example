# Copy to .env and adjust. Never commit .env.
# The passwords below are local development credentials, matching docker-compose.yml.
#
# One URL per role, because one URL would mean one set of privileges and the point is that
# these three cannot do the same things. Run `npm run migrate`, then `npm run provision`,
# and the last two users exist with these passwords.
#
# Two kinds of role are involved. `ledger_app` and `ledger_auditor` are groups: they carry
# the privileges and cannot log in. `ledger_writer` and `ledger_reader` are the identities
# that connect, and they hold no privileges of their own beyond their group's. What you may
# do and who you are are kept separate, so a credential can be rotated without touching a
# single grant.

# The owner. Runs migrations, provisions logins, sets up test fixtures.
DATABASE_ADMIN_URL=postgresql://ledger:ledger@localhost:5432/ledger

# The application, in group ledger_app. Reads and appends; cannot update or delete.
DATABASE_URL=postgresql://ledger_writer:ledger_writer@localhost:5432/ledger

# The reconciliation job, in group ledger_auditor. SELECT and nothing else.
DATABASE_AUDITOR_URL=postgresql://ledger_reader:ledger_reader@localhost:5432/ledger
